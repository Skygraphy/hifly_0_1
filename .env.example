# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres (Drizzle ORM)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Öffentliche Basis-URL (S3- oder CDN-Domain) für die thumb.jpg-Anzeige auf
# /images — setzt voraus, dass der Bucket (bzw. zumindest das */thumb.jpg-
# Prefix) auf public-read gestellt ist (Bucket-Policy, nicht Teil dieses
# Codes), z.B. https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=

# Google Maps (Kartenansicht auf /images)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
# nur für scripts/generate-apple-client-secret.mjs benötigt:
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=
# Ausgabe von scripts/generate-apple-client-secret.mjs, alle ~175 Tage neu generieren:
AUTH_APPLE_SECRET=
AUTH_PAYPAL_ID=
AUTH_PAYPAL_SECRET=
# sandbox | live
AUTH_PAYPAL_ENV=sandbox

# Super-Admin Bootstrapping (scripts/seed-super-admin.mjs)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# Stripe (Shop-Checkout, src/lib/stripe.ts)
STRIPE_SECRET_KEY=
# Signatur-Secret des Webhook-Endpunkts (src/app/api/stripe/webhook/route.ts),
# aus dem Stripe-Dashboard bzw. `stripe listen` für lokale Entwicklung.
STRIPE_WEBHOOK_SECRET=
# Client-seitig für das Payment Element auf /checkout/[orderId] geladen
# (NEXT_PUBLIC_-Präfix, daher unbedenklich öffentlich) — Gegenstück zum
# STRIPE_SECRET_KEY oben, aus demselben Stripe-Dashboard (Publishable key).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Bestell-Bestätigungsmail (src/lib/ses.ts) — nutzt dieselben AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY/AWS_REGION wie S3 oben. Muss in SES als Absender
# verifiziert sein (im SES-Sandbox-Modus zusätzlich JEDER Empfänger).
SES_FROM_EMAIL=
